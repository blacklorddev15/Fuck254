# Required database connection
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Courtney Tech v2 API credentials (server-side only)
COURTNEY_BASE_URL=https://courtneytech.xyz/api
COURTNEY_API_KEY=
COURTNEY_API_SECRET=
COURTNEY_ACCOUNT_ID=

# Blacklord STK provider (server-side only)
BLACKLORD_STK_BASE_URL=https://stk.blacklord.tech/api
BLACKLORD_STK_API_KEY=
BLACKLORD_STK_API_SECRET=
BLACKLORD_STK_INITIATE_PATH=/v2/stkpush
BLACKLORD_STK_STATUS_PATH=/v2/status
BLACKLORD_STK_CALLBACK_URL=https://blacklord.tech/api/user/callback
PUBLIC_APP_URL=https://blacklord.tech

# Blacklord STK destination defaults
BLACKLORD_STK_PAYMENT_MODE=paybill
BLACKLORD_STK_SHORTCODE=
BLACKLORD_STK_TILL_NUMBER=

# Manual bank transfer display settings
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_SWIFT=
BANK_INSTRUCTIONS=

# Optional payment provider
PAYSTACK_SECRET=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_KEY_API_SECRET=
ADMIN_CHAT_ID=

# WhatsApp login infrastructure
# Link opened by members after requesting a one-time login code
WHATSAPP_LOGIN_BOT_URL=https://wa.me/254700000000
# Optional provider endpoint that accepts { phone, code, expiresInMinutes }
WHATSAPP_LOGIN_DELIVERY_URL=

# Domain and subdomain marketplace (server-side only; never expose these in browser code)
BLACKLORD_SUBDOMAIN_BASE=blacklord.tech
BLACKLORD_SUBDOMAIN_TARGET=
BLACKLORD_SUBDOMAIN_PRICE_SD=10
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Staging WhatsApp pairing bridge (server-side only; never expose these in browser code)
PTERODACTYL_PANEL_URL=https://panels.tnppanels.top
PTERODACTYL_CLIENT_API_KEY=
PTERODACTYL_SERVER_IDENTIFIER=
BOT_PAIRING_ENDPOINT=
# Direct bridge wait before the site falls back to database polling (1000–5000 ms)
PAIRING_BRIDGE_TIMEOUT_MS=2500
BOT_PAIRING_SECRET=
PAIRING_WEBHOOK_SECRET=
